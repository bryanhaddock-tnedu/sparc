{
  "name": "sparc",
  "version": "0.1.43",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "dev:backend": "uvicorn app.main:app --app-dir backend --reload",
