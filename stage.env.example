# Copy to stage.env for local stage-container testing.
# Do not commit stage.env with real values.
#
# In Kubernetes, DevOps should provide these same values from Key Vault
# or the cluster's standard secret injection mechanism.

# Azure PostgreSQL connection string for SPARC.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>

# Public origin for the deployed SPARC app.
SPARC_FRONTEND_ORIGIN=https://sparc-stage.example.gov

# Default fiscal year shown when a user has not selected one yet.
SPARC_DEFAULT_FISCAL_YEAR=2027

# Optional explicit build/version stamp. If omitted, SPARC uses the committed
# frontend JavaScript/interface version from frontend/public/app-version.json.
SPARC_BUILD_VERSION=

# Local port only used when running docker-compose.stage.yml manually.
SPARC_PORT=8000

# SPARC session auth and break-glass app login.
AUTH_ENABLED=true
AUTH_USERNAME=sparc
AUTH_PASSWORD=<set-in-key-vault>
AUTH_SESSION_SECRET=<set-random-32-byte-secret-in-key-vault>
AUTH_SESSION_MINUTES=720

# Microsoft Entra SSO. Keep disabled until the app registration values are available.
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://sparc.uat.tnedu.gov/api/auth/entra/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=https://sparc.uat.tnedu.gov/
ENTRA_AUTHORITY_URL=

# Jira REST integration credentials. Keep these server-side only.
JIRA_SITE_URL=https://your-domain.atlassian.net
JIRA_API_EMAIL=
JIRA_API_TOKEN=

# Live Jira actuals sync. Default schedule runs once every morning before 8am Central.
JIRA_AUTO_SYNC_ENABLED=true
JIRA_AUTO_SYNC_TIME=07:30
JIRA_AUTO_SYNC_TIMEZONE=America/Chicago
